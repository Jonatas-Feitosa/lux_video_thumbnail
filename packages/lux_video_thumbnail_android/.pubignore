# Only publish the package's own source and reviewable supporting files.
/*
!/lib/
!/test/
!/pubspec.yaml
!/analysis_options.yaml
!/README.md
!/CHANGELOG.md
!/LICENSE*
!/NOTICE*
!/AUTHORS*
!/COPYING*
!/android/
!/FILE_OWNERSHIP.md

# Generated state, tooling configuration and local dependency resolution.
**/.*
**/build/
**/__pycache__/
**/coverage/
**/doc/api/
**/node_modules/
**/Pods/
**/DerivedData/
**/ephemeral/
**/captures/
**/pubspec.lock
**/pubspec_overrides.yaml
**/*.iml
**/*.ipr
**/*.iws
**/*.class
**/*.pyc
**/*.swp
**/*.log
**/*.tmp
**/*.bak
**/*.dill
**/*.symbols
**/*.apk
**/*.aab
**/*.aar
**/*.dex

# Machine paths, generated registrants and signing/application credentials.
**/local.properties
**/key.properties
**/keystore.properties
**/GeneratedPluginRegistrant.*
**/generated_plugin_registrant.*
**/generated_plugins.cmake
**/flutter_export_environment.sh
**/Generated.xcconfig
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/credentials*.json
**/service-account*.json
